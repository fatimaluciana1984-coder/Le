rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdultBirthDate(birthDate) {
      return birthDate is string
        && birthDate.size() == 10
        && birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          int(birthDate[0:4]) < request.time.year() - 18
          || (
            int(birthDate[0:4]) == request.time.year() - 18
            && (
              int(birthDate[5:7]) < request.time.month()
              || (int(birthDate[5:7]) == request.time.month() && int(birthDate[8:10]) <= request.time.day())
            )
          )
        );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'dailyMinutes', 'dailyGoalMinutes',
          'annualBooksRead', 'annualBooksGoal', 'streakDays', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'dailyMinutes', 'dailyGoalMinutes',
          'annualBooksRead', 'annualBooksGoal', 'streakDays', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.dailyMinutes is int && data.dailyMinutes >= 0 && data.dailyMinutes <= 1440
        && data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 480
        && data.annualBooksRead is int && data.annualBooksRead >= 0 && data.annualBooksRead <= 1000
        && data.annualBooksGoal is int && data.annualBooksGoal >= 1 && data.annualBooksGoal <= 500
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCreatorPayout(data) {
      return data.keys().hasAll([
          'userId', 'fullName', 'birthDate', 'age18Confirmed', 'cpf',
          'pixKeyType', 'pixKey', 'bankName', 'termsAccepted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'fullName', 'birthDate', 'age18Confirmed', 'cpf',
          'pixKeyType', 'pixKey', 'bankName', 'termsAccepted', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 120
        && isAdultBirthDate(data.birthDate)
        && data.age18Confirmed == true
        && data.cpf is string && data.cpf.size() == 11 && data.cpf.matches('^[0-9]{11}$')
        && data.pixKeyType in ['cpf', 'email', 'telefone', 'aleatoria']
        && data.pixKey is string && data.pixKey.size() >= 5 && data.pixKey.size() <= 140
        && data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 80
        && data.termsAccepted == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBook(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'title', 'synopsis', 'genre',
          'coverPreset', 'content', 'priceCents', 'status', 'adultMonetized', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'title', 'synopsis', 'genre',
          'coverPreset', 'content', 'priceCents', 'status', 'adultMonetized', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.synopsis is string && data.synopsis.size() >= 10 && data.synopsis.size() <= 1200
        && data.genre in ['Ficção', 'Romance', 'Mistério', 'Ensaios', 'Poesia', 'Desenvolvimento Pessoal']
        && data.coverPreset in ['stories', 'woods', 'midnight', 'shadow', 'slow']
        && data.content is string && data.content.size() >= 20 && data.content.size() <= 120000
        && data.priceCents is int && data.priceCents >= 0 && data.priceCents <= 999900
        && data.status in ['draft', 'published']
        && data.adultMonetized is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasVerifiedAdultPayout(uid) {
      return exists(/databases/$(database)/documents/creatorPayouts/$(uid))
        && get(/databases/$(database)/documents/creatorPayouts/$(uid)).data.age18Confirmed == true
        && get(/databases/$(database)/documents/creatorPayouts/$(uid)).data.termsAccepted == true;
    }

    function isValidPurchase(data) {
      return data.keys().hasAll([
          'id', 'bookId', 'bookTitle', 'buyerId', 'authorId', 'amountCents', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'bookId', 'bookTitle', 'buyerId', 'authorId', 'amountCents', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.bookId)
        && data.bookTitle is string && data.bookTitle.size() >= 1 && data.bookTitle.size() <= 140
        && isValidId(data.buyerId)
        && data.buyerId == request.auth.uid
        && isValidId(data.authorId)
        && data.amountCents is int && data.amountCents >= 0 && data.amountCents <= 999900
        && data.createdAt is timestamp;
    }

    function isValidReadingProgress(data) {
      return data.keys().hasAll([
          'id', 'userId', 'bookId', 'percent', 'bookmarked', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'bookId', 'percent', 'bookmarked', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidId(data.bookId)
        && data.percent is int && data.percent >= 0 && data.percent <= 100
        && data.bookmarked is bool
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules

    // Private user reading profiles & goals (PII isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['dailyMinutes', 'streakDays', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['dailyGoalMinutes', 'annualBooksGoal', 'annualBooksRead', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        );
      allow delete: if false;
    }

    // Strictly private 18+ creator payout & tax registration (PII + CPF + PIX)
    match /creatorPayouts/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidCreatorPayout(incoming())
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidCreatorPayout(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'birthDate', 'age18Confirmed', 'cpf', 'pixKeyType', 'pixKey', 'bankName', 'termsAccepted', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Books collection: public reads only for published books, drafts strictly owner-only
    match /books/{bookId} {
      allow get: if isValidId(bookId)
        && (existing().status == 'published' || (isSignedIn() && existing().authorId == request.auth.uid));
      allow list: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isValidId(bookId)
        && isVerifiedUser()
        && isValidBook(incoming())
        && incoming().id == bookId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().priceCents == 0 && incoming().adultMonetized == false)
          || hasVerifiedAdultPayout(request.auth.uid)
        );
      allow update: if isValidId(bookId)
        && isVerifiedUser()
        && isValidBook(incoming())
        && existing().authorId == request.auth.uid
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().priceCents == 0 && incoming().adultMonetized == false)
          || hasVerifiedAdultPayout(request.auth.uid)
        )
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'synopsis', 'genre', 'coverPreset', 'content', 'priceCents', 'status', 'adultMonetized', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isValidId(bookId)
        && isVerifiedUser()
        && existing().authorId == request.auth.uid;
    }

    // Immutable reader purchases linked to published books
    match /purchases/{purchaseId} {
      allow get: if isValidId(purchaseId)
        && isSignedIn()
        && (existing().buyerId == request.auth.uid || existing().authorId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.authorId == request.auth.uid);
      allow create: if isValidId(purchaseId)
        && isVerifiedUser()
        && isValidPurchase(incoming())
        && incoming().id == purchaseId
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/books/$(incoming().bookId))
        && get(/databases/$(database)/documents/books/$(incoming().bookId)).data.status == 'published'
        && get(/databases/$(database)/documents/books/$(incoming().bookId)).data.authorId == incoming().authorId
        && get(/databases/$(database)/documents/books/$(incoming().bookId)).data.priceCents == incoming().amountCents
        && incoming().buyerId != incoming().authorId;
      allow update, delete: if false;
    }

    // Reading progress & bookmarks per user
    match /readingProgress/{progressId} {
      allow get: if isValidId(progressId)
        && isSignedIn()
        && existing().userId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isValidId(progressId)
        && isVerifiedUser()
        && isValidReadingProgress(incoming())
        && incoming().id == progressId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(progressId)
        && isVerifiedUser()
        && isValidReadingProgress(incoming())
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().bookId == existing().bookId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['percent', 'bookmarked', 'updatedAt']);
      allow delete: if isValidId(progressId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid;
    }
  }
}
